# Copy this file to .env.local for local testing, and enter the same names
# in your hosting provider's "Environment Variables" screen for deployment.
# NEVER commit real values. NEVER prefix these with NEXT_PUBLIC_.

# From Supabase: Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=put-the-service-role-key-here

# Random secrets, 32+ characters each. Generate with:  openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-string
CODE_PEPPER=replace-with-another-long-random-string

# Organiser passwords (choose long, unique ones)
ADMIN_PASSWORD=replace-with-a-strong-admin-password
# Optional: a second, weaker role that can only confirm redemptions.
# Leave empty to disable.
STAFF_PASSWORD=

# Optional: lets the Selfie Wall ask Claude whether a real person is in front of the right background (Anthropic Console → API keys)
ANTHROPIC_API_KEY=
